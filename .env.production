# VAPID public key do Firebase Cloud Messaging (Web Push)
# Origem: Firebase Console > Configuracoes do projeto > Cloud Messaging > Certificados Push da Web
# NOTA: esta e uma chave PUBLICA (entregue aos navegadores por design) - seguro versionar.
VITE_FIREBASE_VAPID_KEY=BOtJb2JG8o0o2VdwECqF0I_tThrj7MWbE3jxgXq_ECga2Uvn3zXRgVRtR7dAQ_VcIta2toE8dLCJBSCg-BCSw4k

# ── Catálogo externo de canais (Saimo-style) ─────────────────────────────
# Pasta dos arquivos external-channels.txt / external-bases.txt.
# Na VPS o deploy fica em /home/ubuntu/play-infinity (o default abaixo já
# resolve via process.cwd() → data/ — só descomente se precisar apontar
# para outro lugar).
# EXTERNAL_CATALOG_DIR=/home/ubuntu/play-infinity/data
