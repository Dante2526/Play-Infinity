TMDB_API_KEY=
VITE_TMDB_API_KEY=
# URL do servidor proxy dedicado de streaming de TV ao vivo (Oracle VPS). Ex: https://stream.seudominio.com
VITE_PROXY_URL=
# Cloudflare Worker (proxy universal pra sites CF-protected)
# Deploy: ver worker/README.md. Resolves anti-bot de superflix48.lol, bolodechocolate.fit, vizer.autos, etc.
# Ex: https://play-infinity-proxy.seu-subdominio.workers.dev/api/proxy
WORKER_PROXY_URL=
# Cloudflare Turnstile (Anti-Bot)
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Asaas (Gateway de Pagamentos e Webhooks)
ASAAS_API_KEY=
ASAAS_ENVIRONMENT=production # ou sandbox
ASAAS_WEBHOOK_TOKEN= # Token de autenticação configurado na fila de Webhook do painel Asaas (validação via asaas-access-token)

ORACLE_VPS_HOST=
ORACLE_VPS_PORT=22
ORACLE_VPS_USER=ubuntu
# Chave privada SSH (em texto plano com quebras de linha ou coloque o arquivo em secrets/oracle-vps.key)
ORACLE_SSH_KEY=
ORACLE_HEALTH_URL=https://play-infinity.stream/api/health
