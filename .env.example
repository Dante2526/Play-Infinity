# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TMDB API (The Movie Database):
VITE_TMDB_API_KEY="seu_tmdb_api_key_aqui"
VITE_TMDB_ACCESS_TOKEN="seu_tmdb_access_token_aqui"

# Webhook Secret (para POST /api/novo-episodio):
# Gere uma chave segura aleatória (ex: openssl rand -hex 32)
WEBHOOK_SECRET="sua_chave_secreta_aleatoria_aqui"
