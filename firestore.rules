rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email in ['naylanmoreira350@gmail.com', 'cbeth761@gmail.com'] ||
        (request.auth.token.email_verified == true && exists(/databases/$(database)/documents/administradores/$(request.auth.uid)))
      );
    }

    match /administradores/{userId} {
      allow read: if isAdmin() || request.auth.uid == userId;
      allow write: if false; 
    }
    
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isSafeCreate() {
      let allowedKeys = [
        "nome", "email", "senha", "assinatura", "tipoAcesso",
        "photoURL", "historicoReproducao", "historicoRemovido", "episodiosAssistidos",
        "favoritos", "createdAt", "updatedAt", "valorMensalidade", "valor", "criadoEm"
      ];
      let keysOk = request.resource.data.keys().hasOnly(allowedKeys);
      let assinaturaOk = !("assinatura" in request.resource.data) || request.resource.data.assinatura == "INATIVA";
      let tipoAcessoOk = !("tipoAcesso" in request.resource.data) || request.resource.data.tipoAcesso == "mensal";
      return keysOk && assinaturaOk && tipoAcessoOk;
    }

    function isSafeUpdate() {
      let allowedKeys = [
        "nome", "email", "photoURL", "senha", "senhaInicial",
        "historicoReproducao", "historicoRemovido", "episodiosAssistidos",
        "favoritos", "createdAt", "updatedAt",
        "assinatura", "subscription", "valorMensalidade", "valor", "ultimoAcesso", "lastActive"
      ];
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let hasOnlyAllowed = affectedKeys.hasOnly(allowedKeys);

      let tryingToChangeSubscription = affectedKeys.hasAny(["assinatura", "subscription"]);
      let isValidSubscriptionChange = !tryingToChangeSubscription || (
        request.resource.data.assinatura == "EXPIRADA" && 
        request.resource.data.subscription == "INACTIVE"
      );
      
      return hasOnlyAllowed && isValidSubscriptionChange;
    }

    match /usuarios/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) && isSafeCreate()) || isAdmin();
      allow update: if (isOwner(userId) && isSafeUpdate()) || isAdmin();
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) && isSafeCreate()) || isAdmin();
      allow update: if (isOwner(userId) && isSafeUpdate()) || isAdmin();
      allow delete: if isAdmin();
    }

    match /bug_reports/{reportId} {
      // Create: qualquer um pode reportar, desde que status=pending, clientId válido,
      // description legível (1-2000 chars) e APENAS os campos previstos pelo modal
      // (impede gravar payloads arbitrários/oversized na coleção).
      allow create: if request.resource.data.status == "pending"
        && request.resource.data.clientId is string
        && request.resource.data.clientId.size() > 0
        && request.resource.data.clientId.size() <= 64
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 2000
        && request.resource.data.keys().hasOnly([
             "clientId", "userName", "userEmail", "mediaId", "mediaTitle", "mediaType",
             "episodeInfo", "description", "imageUrl", "storagePath", "status", "adminResponse", "createdAt"
           ]);

      // Read: Admin tem acesso total. Cliente lê apenas os próprios relatórios
      // (clientId == request.auth.uid quando o usuário está logado — o modal
      // grava o uid como clientId, o que faz o BugFeedbackListener funcionar).
      // NOTA: request.query NÃO existe na linguagem de regras do Firestore —
      // a cláusula antiga com request.query.limit sempre falhava (erro de avaliação).
      allow read: if isAdmin() || (request.auth != null && resource.data.clientId == request.auth.uid);

      // Update: apenas admin resolve/responde.
      allow update: if isAdmin();

      // Delete: admin tem acesso total; cliente apaga o próprio relatório
      // (após visualizar o feedback resolvido).
      allow delete: if isAdmin() || (request.auth != null && resource.data.clientId == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
