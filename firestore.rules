rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email in ['naylanmoreira350@gmail.com', 'cbeth761@gmail.com'] ||
        (request.auth.token.email_verified == true && exists(/databases/$(database)/documents/administradores/$(request.auth.uid)))
      );
    }

    match /administradores/{userId} {
      allow read: if isAdmin() || request.auth.uid == userId;
      allow write: if false; 
    }
    
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isSafeCreate() {
      let allowedKeys = [
        "nome", "email", "senha", "assinatura", "tipoAcesso",
        "photoURL", "historicoReproducao", "historicoRemovido", "episodiosAssistidos",
        "favoritos", "createdAt", "updatedAt", "valorMensalidade", "valor", "criadoEm"
      ];
      let keysOk = request.resource.data.keys().hasOnly(allowedKeys);
      let assinaturaOk = !("assinatura" in request.resource.data) || request.resource.data.assinatura == "INATIVA";
      let tipoAcessoOk = !("tipoAcesso" in request.resource.data) || request.resource.data.tipoAcesso == "mensal";
      return keysOk && assinaturaOk && tipoAcessoOk;
    }

    function isSafeUpdate() {
      let allowedKeys = [
        "nome", "email", "photoURL", "senha", "senhaInicial",
        "historicoReproducao", "historicoRemovido", "episodiosAssistidos",
        "favoritos", "createdAt", "updatedAt",
        "assinatura", "subscription", "valorMensalidade", "valor", "ultimoAcesso", "lastActive"
      ];
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let hasOnlyAllowed = affectedKeys.hasOnly(allowedKeys);

      let tryingToChangeSubscription = affectedKeys.hasAny(["assinatura", "subscription"]);
      let isValidSubscriptionChange = !tryingToChangeSubscription || (
        request.resource.data.assinatura == "EXPIRADA" && 
        request.resource.data.subscription == "INACTIVE"
      );
      
      return hasOnlyAllowed && isValidSubscriptionChange;
    }

    match /usuarios/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) && isSafeCreate()) || isAdmin();
      allow update: if (isOwner(userId) && isSafeUpdate()) || isAdmin();
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) && isSafeCreate()) || isAdmin();
      allow update: if (isOwner(userId) && isSafeUpdate()) || isAdmin();
      allow delete: if isAdmin();
    }

    match /bug_reports/{reportId} {
      // Create: Anyone can create if they provide their clientId and status is pending
      allow create: if request.resource.data.keys().hasAll(["clientId", "status"]) && request.resource.data.status == "pending";
      
      // Read, Update, Delete: Admin can do anything. Client can only read/delete their own reports.
      allow read, update, delete: if isAdmin() || resource.data.clientId == request.auth.uid || (resource.data.clientId != null && request.query.limit <= 20); 
      // Note: Because clientId is passed from localStorage, we can't secure reads purely by auth.uid if unauthenticated, 
      // but we allow limited reading so the client can query their own clientId.
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
